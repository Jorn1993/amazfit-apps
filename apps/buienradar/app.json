{
  "configVersion": "v3",
  "app": {
    "appId": 1936821,
    "appName": "Buienradar",
    "appType": "app",
    "version": {
      "name": "0.2.0",
      "code": 2
    },
    "vender": "Personal prototype",
    "description": "3-screen rain radar, rainfall chart and forecast with shortcut card",
    "icon": "icon.png"
  },
  "permissions": [
    "device:os.geolocation",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "minVersion": "3.0",
      "target": "3.0",
      "compatible": "3.0"
    }
  },
  "targets": {
    "balance2": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        },
        "app-widget": {
          "widgets": [
            {
              "path": "app-widget/index",
              "icon": "icon.png",
              "name": "Buienradar",
              "runtime": {
                "type": "js"
              }
            }
          ]
        }
      },
      "platforms": [
        {
          "name": "Balance 2",
          "deviceSource": 9568513
        },
        {
          "name": "Balance 2",
          "deviceSource": 9568515
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "nl-NL": {
      "appName": "Buienradar"
    }
  },
  "defaultLanguage": "nl-NL"
}
